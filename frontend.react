import React, { useState, useEffect } from 'react';

// ATTRIBUTE_METADATA will now be fetched from the backend.
// We keep a placeholder here for initial rendering or if backend is not yet available,
// but it will be overwritten by the fetched data.
const ATTRIBUTE_METADATA_PLACEHOLDER = {
    "date": { description: "Time (year-month-day hour:minute:second)", type: "string" },
    "Appliances": { description: "Energy use of appliances (Wh)", type: "number" },
    "lights": { description: "Energy use of light fixtures (Wh)", type: "number" },
    "T1": { description: "Temperature in kitchen area (°C)", type: "number" },
    "RH_1": { description: "Humidity in kitchen area (%)", type: "number" },
    "T2": { description: "Temperature in living room area (°C)", type: "number" },
    "RH_2": { description: "Humidity in living room area (%)", type: "number" },
    "T3": { description: "Temperature in laundry room area (°C)", type: "number" },
    "RH_3": { description: "Humidity in laundry room area (%)", type: "number" },
    "T4": { description: "Temperature in office room (°C)", type: "number" },
    "RH_4": { description: "Humidity in office room (%)", type: "number" },
    "T5": { description: "Temperature in bathroom (°C)", type: "number" },
    "RH_5": { description: "Humidity in bathroom (%)", type: "number" },
    "T6": { description: "Temperature outside (north side) (°C)", type: "number" },
    "RH_6": { description: "Humidity outside (north side) (%)", type: "number" },
    "T7": { description: "Temperature in ironing room (°C)", type: "number" },
    "RH_7": { description: "Humidity in ironing room (%)", type: "number" },
    "T8": { description: "Temperature in teenager room 2 (°C)", type: "number" },
    "RH_8": { description: "Humidity in teenager room 2 (%)", type: "number" },
    "T9": { description: "Temperature in parents room (°C)", type: "number" },
    "RH_9": { description: "Humidity in parents room (%)", type: "number" },
    "To": { description: "Temperature outside (Chievres weather station) (°C)", type: "number" },
    "Pressure": { description: "Pressure (Chievres weather station) (mm Hg)", type: "number" },
    "RH_out": { description: "Humidity outside (Chievres weather station) (%)", type: "number" },
    "Wind speed": { description: "Wind speed (Chievres weather station) (m/s)", type: "number" },
    "Visibility": { description: "Visibility (Chievres weather station) (km)", type: "number" },
    "Tdewpoint": { description: "Dewpoint temperature (Chievres weather station) (°C)", type: "number" },
    "rv1": { description: "Random variable 1 (nondimensional)", type: "number" },
    "rv2": { description: "Random variable 2 (nondimensional)", type: "number" }
};


// Main App component
const App = () => {
    // State to hold the list of graphs (correlation groups)
    const [graphs, setGraphs] = useState([]);
    // State to hold the currently selected graph (correlation group) for the modal
    const [selectedGraph, setSelectedGraph] = useState(null);
    // State for dynamic filter attributes. Keys are attribute names, values are boolean (checked/unchecked).
    const [filters, setFilters] = useState({});
    // State to track if the data is loading (for future API calls)
    const [loading, setLoading] = useState(true);
    // State to store the fetched attribute metadata
    const [attributeMetadata, setAttributeMetadata] = useState(ATTRIBUTE_METADATA_PLACEHOLDER);
    // State for Firebase DB and Auth instances (placeholder for future integration)
    const [db, setDb] = useState(null);
    const [auth, setAuth] = useState(null);
    const [userId, setUserId] = useState(null);

    // Effect to fetch data from the Python backend
    useEffect(() => {
        const fetchData = async () => {
            try {
                // Fetch attribute metadata first
                const metadataResponse = await fetch('http://127.0.0.1:5000/api/attribute_metadata');
                if (!metadataResponse.ok) {
                    throw new Error(`HTTP error! status: ${metadataResponse.status}`);
                }
                const fetchedMetadata = await metadataResponse.json();
                setAttributeMetadata(fetchedMetadata);

                // Initialize filters based on fetched metadata
                const initialFilters = {};
                Object.keys(fetchedMetadata).forEach(attr => {
                    initialFilters[attr] = false;
                });
                setFilters(initialFilters);

                // Then fetch graph data
                const graphsResponse = await fetch('http://127.0.0.1:5000/api/graphs');
                if (!graphsResponse.ok) {
                    throw new Error(`HTTP error! status: ${graphsResponse.status}`);
                }
                const fetchedGraphs = await graphsResponse.json();
                setGraphs(fetchedGraphs);

            } catch (error) {
                console.error('Error fetching data:', error);
                // Fallback to dummy data or show an error message to the user
                // For now, we'll just log the error and keep loading state
            } finally {
                setLoading(false);
            }
        };

        fetchData();
    }, []); // Empty dependency array means this effect runs once on mount

    // Function to handle graph (correlation group) clicks and open the modal
    const handleGraphClick = (graph) => {
        setSelectedGraph(graph);
    };

    // Function to close the modal
    const closeModal = () => {
        setSelectedGraph(null);
    };

    // Function to handle dynamic filter changes
    const handleFilterChange = (e) => {
        const { name, checked } = e.target;
        setFilters((prevFilters) => ({
            ...prevFilters,
            [name]: checked,
        }));
    };

    // Filtered graphs based on the current filter settings
    const filteredGraphs = graphs.filter((graph) => {
        // Iterate through active filters and check if the graph's attributes contain the filtered attribute
        for (const attrName in filters) {
            if (filters[attrName]) { // If this filter is checked
                // If the graph's attributes object does NOT contain the attribute, it doesn't pass the filter
                if (!graph.attributes.hasOwnProperty(attrName)) {
                    return false;
                }
            }
        }
        return true; // Graph passes all active filters
    });

    if (loading) {
        return (
            <div className="flex items-center justify-center min-h-screen bg-gray-100 font-inter">
                <p className="text-xl text-gray-700">Loading correlation groups...</p>
            </div>
        );
    }

    return (
        <div className="min-h-screen bg-gray-100 p-4 sm:p-6 font-inter flex flex-col items-center">
            {/* Header */}
            <header className="w-full max-w-4xl text-center mb-8">
                <h1 className="text-4xl font-bold text-gray-800 mb-2">GPT Graph Analyzer</h1>
                <p className="text-lg text-gray-600">Explore attribute correlations in your datasets.</p>
            </header>

            {/* Main content area */}
            <div className="w-full max-w-4xl bg-white rounded-xl shadow-lg p-6 mb-8">
                <h2 className="text-2xl font-semibold text-gray-700 mb-4">Filter Correlation Groups by Attribute</h2>
                <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    {/* Use the dynamically fetched attributeMetadata for rendering filters */}
                    {Object.entries(attributeMetadata).map(([attrName, metadata]) => (
                        <label key={attrName} className="flex items-center cursor-pointer p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                            <input
                                type="checkbox"
                                name={attrName}
                                checked={filters[attrName] || false} // Ensure it's never undefined
                                onChange={handleFilterChange}
                                className="form-checkbox h-5 w-5 text-blue-600 rounded-md focus:ring-blue-500"
                            />
                            <span className="ml-2 text-gray-700">
                                {metadata.description.split(' (')[0]} {/* Display just the name part */}
                            </span>
                        </label>
                    ))}
                </div>
            </div>

            <div className="w-full max-w-4xl bg-white rounded-xl shadow-lg p-6">
                <h2 className="text-2xl font-semibold text-gray-700 mb-4">Available Correlation Groups</h2>
                {filteredGraphs.length === 0 ? (
                    <p className="text-gray-500">No correlation groups match your current filters.</p>
                ) : (
                    <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                        {filteredGraphs.map((graph) => (
                            <div
                                key={graph.id}
                                className="bg-blue-50 rounded-xl p-4 cursor-pointer hover:shadow-md transition-shadow duration-200 flex flex-col justify-between"
                                onClick={() => handleGraphClick(graph)}
                            >
                                <h3 className="text-xl font-semibold text-blue-800 mb-2">{graph.name}</h3>
                                <p className="text-gray-700 text-sm mb-3 line-clamp-2">{graph.description}</p>
                                {/* Placeholder for actual graph visualization (e.g., an SVG icon or simple shape) */}
                                <div className="mt-4 flex justify-center items-center h-24 bg-blue-100 rounded-lg border-2 border-dashed border-blue-300 text-blue-500 text-sm">
                                    Correlation Visualization Placeholder
                                </div>
                            </div>
                        ))}
                    </div>
                )}
            </div>

            {/* Graph Details Modal */}
            {selectedGraph && (
                <div className="fixed inset-0 bg-gray-800 bg-opacity-75 flex items-center justify-center p-4 z-50 overflow-y-auto">
                    <div className="bg-white rounded-xl shadow-2xl p-6 w-full max-w-lg relative my-8 max-h-[90vh] overflow-y-auto">
                        <button
                            onClick={closeModal}
                            className="absolute top-3 right-3 text-gray-500 hover:text-gray-800 text-2xl font-bold"
                            aria-label="Close modal"
                        >
                            &times;
                        </button>
                        <h2 className="text-3xl font-bold text-gray-800 mb-4">{selectedGraph.name}</h2>
                        <p className="text-gray-700 mb-4">{selectedGraph.description}</p>

                        <h3 className="text-xl font-semibold text-gray-700 mb-3">Attributes in this Group:</h3>
                        <div className="grid grid-cols-1 gap-2 text-gray-600 mb-6">
                            <p><span className="font-semibold">Group ID:</span> {selectedGraph.id}</p>
                            {/* Dynamically display all attributes from the selected graph using fetched metadata */}
                            {Object.keys(selectedGraph.attributes).filter(attr => attr !== 'count').map((attrName) => {
                                const metadata = attributeMetadata[attrName]; // Use fetched metadata
                                if (!metadata) return null; // Skip if no metadata for this attribute

                                return (
                                    <p key={attrName}>
                                        <span className="font-semibold">{metadata.description.split(' (')[0]}:</span> {metadata.description}
                                    </p>
                                );
                            })}
                            {selectedGraph.attributes.count && <p><span className="font-semibold">Total Attributes:</span> {selectedGraph.attributes.count}</p>}
                        </div>

                        {selectedGraph.correlationText && (
                            <>
                                <h3 className="text-xl font-semibold text-gray-700 mb-3">Correlation Explanation</h3>
                                <div className="bg-blue-50 rounded-lg p-4 mb-6 border border-blue-200">
                                    <p className="text-gray-800 italic">{selectedGraph.correlationText}</p>
                                </div>
                            </>
                        )}

                        {/* Placeholder for more detailed graph visualization or interactive elements within the modal */}
                        <div className="bg-gray-100 rounded-lg p-4 text-center text-gray-500 h-48 flex items-center justify-center mb-6">
                            Detailed Correlation Visualization Here
                        </div>

                        <button
                            onClick={closeModal}
                            className="mt-2 w-full bg-blue-600 text-white py-3 rounded-lg hover:bg-blue-700 transition-colors font-semibold shadow-md"
                        >
                            Close
                        </button>
                    </div>
                </div>
            )}
        </div>
    );
};

export default App;
